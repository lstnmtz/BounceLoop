import pygame
import math
import random
import time

# --- CONFIGURATION ---
WIDTH, HEIGHT = 720, 1280
FPS = 60
DURATION = 25  # seconds
TOTAL_FRAMES = FPS * DURATION
BALL_RADIUS = 80
SECONDARY_RADIUS = 40
COLOR_TRANSITION_SPEED = 0.005
SOUND_INTERVAL = 2  # seconds between different sound types

# Colors (harmonious palette transitions)
PALETTE = [
    (255, 183, 197),
    (183, 225, 255),
    (197, 255, 217),
    (255, 255, 183),
    (255, 214, 165)
]

def lerp_color(c1, c2, t):
    return tuple(int(c1[i] + (c2[i] - c1[i]) * t) for i in range(3))

# Setup pygame
pygame.init()
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Bouncing Ball Loop")
clock = pygame.time.Clock()

# Load placeholder sounds (customize with TikTok sounds later)
sounds = [pygame.mixer.Sound("pop.mp3") for _ in range(3)]  # Placeholder: Replace manually

# Utility for squash/stretch effect
def draw_squash_ball(surface, pos, radius, squash_factor, color):
    width = radius * 2 * (1 + squash_factor)
    height = radius * 2 * (1 - squash_factor)
    ellipse_rect = pygame.Rect(0, 0, width, height)
    ellipse_rect.center = pos
    pygame.draw.ellipse(surface, color, ellipse_rect)

# Halo effect
def draw_halo(surface, pos, color, radius):
    halo_color = (*color, 80)
    halo_surf = pygame.Surface((radius*4, radius*4), pygame.SRCALPHA)
    pygame.draw.circle(halo_surf, halo_color, (radius*2, radius*2), radius*2)
    halo_rect = halo_surf.get_rect(center=pos)
    surface.blit(halo_surf, halo_rect)

# Secondary ball structure
class SecondaryBall:
    def __init__(self, pos, start_frame):
        self.pos = pos
        self.start_frame = start_frame
        self.age = 0

    def update(self):
        self.age += 1

    def draw(self, surface):
        offset = math.sin((self.age / FPS) * math.pi * 2) * 200
        y = self.pos[1] - offset
        pygame.draw.circle(surface, (255, 255, 255), (self.pos[0], int(y)), SECONDARY_RADIUS)

# Main animation loop
frame = 0
running = True
secondary_balls = []
current_color_index = 0
next_color_index = 1
color_t = 0
last_sound_type = 0
last_rebound_frame = -999

# Vitesse initiale de la balle principale
vx = random.uniform(-5, 5)  # Vitesse horizontale aléatoire
vy = random.uniform(-5, 5)  # Vitesse verticale aléatoire

while running:
    clock.tick(FPS)
    frame += 1
    if frame > TOTAL_FRAMES:
        frame = 0
        secondary_balls = []
        current_color_index = 0
        next_color_index = 1
        color_t = 0
        last_sound_type = 0
        last_rebound_frame = -999

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Background color interpolation
    color_t += COLOR_TRANSITION_SPEED
    if color_t > 1:
        color_t = 0
        current_color_index = next_color_index
        next_color_index = (next_color_index + 1) % len(PALETTE)
    bg_color = lerp_color(PALETTE[current_color_index], PALETTE[next_color_index], color_t)
    screen.fill(bg_color)

    # Main ball motion (circular, easing function)
    t = (frame % TOTAL_FRAMES) / TOTAL_FRAMES
    angle = 2 * math.pi * t
    easing = math.sin(angle) ** 3
    y_offset = easing * (HEIGHT - BALL_RADIUS * 2 - 100)
    ball_y = HEIGHT - BALL_RADIUS - y_offset
    ball_pos = (WIDTH // 2, int(ball_y))

    # Mettre à jour la position de la balle principale
    ball_x, ball_y = ball_pos
    ball_x += vx
    ball_y += vy

    # Modifier légèrement les vitesses pour un effet aléatoire
    vx += random.uniform(-0.5, 0.5)
    vy += random.uniform(-0.5, 0.5)

    # Limiter la vitesse maximale
    vx = max(min(vx, 10), -10)
    vy = max(min(vy, 10), -10)

    # Garder la balle dans les limites de l'écran
    if ball_x - BALL_RADIUS < 0 or ball_x + BALL_RADIUS > WIDTH:
        vx *= -1  # Inverser la direction horizontale
    if ball_y - BALL_RADIUS < 0 or ball_y + BALL_RADIUS > HEIGHT:
        vy *= -1  # Inverser la direction verticale

    # Mettre à jour la position de la balle
    ball_pos = (int(ball_x), int(ball_y))

    # Detect rebound (bottom of bounce)
    if easing < 0.01 and frame - last_rebound_frame > FPS // 3:
        last_rebound_frame = frame
        secondary_balls.append(SecondaryBall(ball_pos, frame))
        # Play sound (alternate type)
        sound_index = last_sound_type % len(sounds)
        sounds[sound_index].play()
        last_sound_type += 1

    # Draw secondary balls
    for ball in secondary_balls:
        ball.update()
        ball.draw(screen)

    # Visual effects
    squash = max(0, 0.3 - abs(easing - 0.5)) * 0.5  # squash at bottom
    draw_squash_ball(screen, ball_pos, BALL_RADIUS, squash, (255, 255, 255))
    if easing < 0.01:
        draw_halo(screen, ball_pos, (255, 255, 255), BALL_RADIUS)

    pygame.display.flip()

pygame.quit()
